# Anthropic — krävs för /api/analyze-prompt, /api/estimate-cost och /api/chat
# Skapa nyckel på console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (aktiveras när leadCaptureEnabled = true i siteConfig.ts)
# Skapa projekt på supabase.com, kopiera URL och anon key
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role — krävs för server-side skrivoperationer (t.ex. leads)
# Finns under Project Settings → API → service_role key (hemlighet — dela ej)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend — krävs för /api/send-guide (e-postutskick)
# Skapa API-nyckel på resend.com
RESEND_API_KEY=re_...

# Twitter/X bot — krävs för /api/twitter-bot (Vercel Cron 3×/dag)
# Skapa app på developer.twitter.com med Read+Write-behörighet
# Generera Access Token för @aikostnad-kontot under "Keys and Tokens"
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Cron-skydd — sätt samma värde i Vercel dashboard under Environment Variables
# Generera t.ex. med: openssl rand -hex 32
CRON_SECRET=

# Vercel Analytics aktiveras automatiskt via Vercel dashboard
# Ingen extra env-variabel krävs

# Valutakurs: hämtas automatiskt via frankfurter.app (gratis, ingen API-nyckel)
# Ingen env-variabel krävs för exchange rate
